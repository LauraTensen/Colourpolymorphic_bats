#!/bin/bash

cd /home/tensenl/BATS/FASTAS/OUTGROUPS

mkdir -p merged_gene_fastas

for dir in gene_fastas/*/; do

    sample=$(basename "$dir")

    echo "Processing $sample"

    # Choose BED coordinates appropriate for this genome
    case "$sample" in

        D1|D2|D3|P1|P2|P3|P4|Mystacinus)
            BEDDIR="candidate_gene_gff_longest"
            ;;

        Brandtii)
            BEDDIR="candidate_gene_gff_Brandtii"
            ;;

        Daubentonii)
            BEDDIR="candidate_gene_gff_Daubentonii"
            ;;

        Lucifugus)
            BEDDIR="candidate_gene_gff_Lucifugus"
            ;;

        Fuscus)
            BEDDIR="candidate_gene_gff_Fuscus"
            ;;

        Myotis)
            BEDDIR="candidate_gene_gff_Myotis"
            ;;

        *)
            echo "WARNING: no BED directory defined for $sample"
            continue
            ;;
    esac


    for file in "$dir"/*.fasta; do

        filename=$(basename "$file" .fasta)

        # e.g. P1_ASIP -> ASIP
        gene="${filename#${sample}_}"

        bed="${BEDDIR}/${gene}.bed"

        if [[ ! -s "$bed" ]]; then
            echo "WARNING: BED missing: $bed"
            continue
        fi

        strand=$(awk 'NR==1 {print $6}' "$bed")

        # Read every FASTA record as one CDS fragment
        mapfile -t seqs < <(
            awk '
                /^>/ {
                    if (seq != "") {
                        print seq
                        seq=""
                    }
                    next
                }
                {
                    seq=seq $0
                }
                END {
                    if (seq != "")
                        print seq
                }
            ' "$file"
        )

        merged=""

        if [[ "$strand" == "+" ]]; then

            for seq in "${seqs[@]}"; do
                merged="${merged}${seq}"
            done

        elif [[ "$strand" == "-" ]]; then

            for ((i=${#seqs[@]}-1; i>=0; i--)); do
                merged="${merged}${seqs[$i]}"
            done

        else
            echo "WARNING: unknown strand for $sample $gene"
            continue
        fi

        {
            echo ">${sample}_${gene}"
            echo "$merged"
        } > "merged_gene_fastas/${sample}_${gene}.fasta"

    done

done


########################################
