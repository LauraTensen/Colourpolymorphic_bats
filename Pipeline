########################################

mkdir -p loci_combined

INPUT_DIR="/merged_gene_fastas"
OUTPUT_DIR="/loci_combined"

cd "$INPUT_DIR"

# Get unique gene names
genes=$(ls *.fasta | sed 's/^[^_]*_//' | sed 's/\.fasta$//' | sort -u)

echo "Combining loci by gene..."

for gene in $genes; do

    out="$OUTPUT_DIR/${gene}.fasta"
    > "$out"

    echo "COMBINE: $gene"

    for f in *_${gene}.fasta; do

        [[ -f "$f" ]] || continue

        # Individual/species name = everything before _GENE.fasta
        ind="${f%_${gene}.fasta}"

        # Replace existing header with individual/species name
        sed "s/^>.*/>$ind/" "$f" >> "$out"

    done

    # Count sequences
    nseq=$(grep -c '^>' "$out" || true)

    # Remove loci represented by fewer than 2 individuals
    if [[ "$nseq" -lt 2 ]]; then
        rm -f "$out"
        echo "  -> removed (only $nseq sequence)"
    else
        echo "  -> $nseq sequences"
    fi

done

