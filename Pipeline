# There are many very short inferred ROHs. ≥100 kb is probaly of biological interest

#  incorporate that directly:
roh <- read.table(
  "ROH_bats_autosomes.txt",
  header = FALSE,
  comment.char = "#",
  fill = TRUE
) %>%
  filter(V1 == "RG") %>%
  transmute(
    Sample = sub("\\.bam$", "", V2),
    Chr = V3,
    Start = as.numeric(V4),
    End = as.numeric(V5),
    Length = as.numeric(V6),
    Markers = as.numeric(V7),
    Quality = as.numeric(V8)
  ) %>%
  mutate(
    Length_kb = Length / 1000,
    Length_Mb = Length / 1e6,
    Morph = ifelse(grepl("^D", Sample), "Dark", "Pale")
  )

