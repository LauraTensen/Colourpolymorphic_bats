gt_alt_count <- function(gt) {
  case_when(
    gt %in% c("0/0", "0|0") ~ 0,
    gt %in% c("0/1", "1/0", "0|1", "1|0") ~ 1,
    gt %in% c("1/1", "1|1") ~ 2,
    TRUE ~ NA_real_
  )
}

screen <- functional %>%
  rowwise() %>%
  mutate(
    AF_D = mean(c(
      gt_alt_count(D1),
      gt_alt_count(D2),
      gt_alt_count(D3)
    ), na.rm = TRUE) / 2,

    AF_P = mean(c(
      gt_alt_count(P1),
      gt_alt_count(P2),
      gt_alt_count(P3),
      gt_alt_count(P4)
    ), na.rm = TRUE) / 2,

    Delta_AF = abs(AF_P - AF_D)
  ) %>%
  ungroup() %>%
  arrange(desc(Delta_AF))

