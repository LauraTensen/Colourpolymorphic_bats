# ============================================================
# INPUTS
# ============================================================

REF=mystacinus.fna
POP=Bats.biallelic_snps.norm.vcf.gz

BR_PAF=brandtii_to_mystacinus.sorted.paf
DA_PAF=daubentonii_to_mystacinus.sorted.paf

BR_VCF=brandtii_vs_mystacinus.norm.sorted.vcf.gz
DA_VCF=daubentonii_vs_mystacinus.norm.sorted.vcf.gz


# ============================================================
# STEP 1. Make BED files of confidently aligned outgroup regions
# ============================================================

# Keep primary/high-confidence mappings.
# PAF columns:
# 6 = target/reference chromosome
# 8 = target start (0-based)
# 9 = target end
# 12 = MAPQ

awk '$12 >= 20 {print $6"\t"$8"\t"$9}' "$BR_PAF" \
    | sort -k1,1 -k2,2n \
    | bedtools merge \
    > brandtii.callable.bed

awk '$12 >= 20 {print $6"\t"$8"\t"$9}' "$DA_PAF" \
    | sort -k1,1 -k2,2n \
    | bedtools merge \
    > daubentonii.callable.bed

# ============================================================
# STEP 2. Find regions callable in BOTH outgroups
# ============================================================

bedtools intersect \
    -a brandtii.callable.bed \
    -b daubentonii.callable.bed \
    > outgroups.callable.bed


# Optional: merge again in case intersect produced adjacent pieces

sort -k1,1 -k2,2n outgroups.callable.bed \
    | bedtools merge \
    > outgroups.callable.merged.bed

# ============================================================
# STEP 3. Restrict population SNPs to regions callable in both
# ============================================================

bcftools view \
    -R outgroups.callable.merged.bed \
    "$POP" \
    -Oz \
    -o Bats.callable_in_both_outgroups.vcf.gz

bcftools index -t Bats.callable_in_both_outgroups.vcf.gz


# ============================================================
# STEP 4. Extract population SNP positions
# ============================================================

bcftools query \
    -f '%CHROM\t%POS\t%REF\t%ALT\n' \
    Bats.callable_in_both_outgroups.vcf.gz \
    > population_sites.tsv

# ============================================================
# STEP 5. Extract outgroup variants at those population positions
# ============================================================

# Make a regions file for bcftools:
awk '{print $1"\t"$2"\t"$2}' population_sites.tsv \
    > population_sites.regions

# Brandtii variants at population SNP positions

bcftools view \
    -R population_sites.regions \
    "$BR_VCF" \
    -Ou |
bcftools query \
    -f '%CHROM\t%POS\t%REF\t%ALT\n' \
    > brandtii.at_population_sites.tsv

# Daubentonii variants at population SNP positions

bcftools view \
    -R population_sites.regions \
    "$DA_VCF" \
    -Ou |
bcftools query \
    -f '%CHROM\t%POS\t%REF\t%ALT\n' \
    > daubentonii.at_population_sites.tsv

# ============================================================
# STEP 6. Determine the allele carried by each outgroup
# ============================================================

# Start with the assumption that, at callable sites without
# an outgroup variant record, the outgroup carries the
# mystacinus REF allele.

awk 'BEGIN{OFS="\t"} {
    print $1,$2,$3,$4,$3
}' population_sites.tsv \
    > brandtii.states.tsv

awk 'BEGIN{OFS="\t"} {
    print $1,$2,$3,$4,$3
}' population_sites.tsv \
    > daubentonii.states.tsv


# ============================================================
# STEP 7. Replace REF with ALT wherever the outgroup has a SNP
# ============================================================

awk '
BEGIN{FS=OFS="\t"}

NR==FNR {
    key=$1":"$2
    alt[key]=$4
    next
}

{
    key=$1":"$2

    if (key in alt)
        $5=alt[key]

    print
}
' brandtii.at_population_sites.tsv \
  brandtii.states.tsv \
  > brandtii.states.updated.tsv


awk '
BEGIN{FS=OFS="\t"}

NR==FNR {
    key=$1":"$2
    alt[key]=$4
    next
}

{
    key=$1":"$2

    if (key in alt)
        $5=alt[key]

    print
}
' daubentonii.at_population_sites.tsv \
  daubentonii.states.tsv \
  > daubentonii.states.updated.tsv


# ============================================================
# STEP 8. Keep only sites where the two outgroups agree
# ============================================================

paste \
    brandtii.states.updated.tsv \
    daubentonii.states.updated.tsv |
awk '
BEGIN{FS=OFS="\t"}

{
    chrom=$1
    pos=$2
    ref=$3
    alt=$4

    brandtii=$5
    daubentonii=$10

    # Require agreement between outgroups
    if (brandtii != daubentonii)
        next

    # Require ancestral allele to equal either REF or ALT
    # of the population SNP
    if (brandtii != ref && brandtii != alt)
        next

    print chrom,pos,ref,alt,brandtii
}
' > ancestral.tsv


# ============================================================
# STEP 9. Compress and index annotation table
# ============================================================

bgzip -c ancestral.tsv > ancestral.tsv.gz

tabix \
    -s1 \
    -b2 \
    -e2 \
    ancestral.tsv.gz


# ============================================================
# STEP 10. Create AA header
# ============================================================

echo '##INFO=<ID=AA,Number=1,Type=String,Description="Putative ancestral allele supported by Myotis brandtii and Myotis daubentonii">' \
    > ancestral.hdr

# ============================================================
# STEP 11. Keep only polarized population SNPs
# ============================================================

bcftools view \
    -R ancestral.tsv.gz \
    Bats.callable_in_both_outgroups.vcf.gz \
    -Oz \
    -o Bats.polarizable.vcf.gz

bcftools index -t Bats.polarizable.vcf.gz

# ============================================================
# STEP 12. Annotate ancestral allele
# ============================================================

bcftools annotate \
    -a ancestral.tsv.gz \
    -h ancestral.hdr \
    -c CHROM,POS,REF,ALT,INFO/AA \
    Bats.polarizable.vcf.gz \
    -Oz \
    -o Bats.ancestral.vcf.gz

bcftools index -t Bats.ancestral.vcf.gz


# ============================================================
# STEP 13. QC
# ============================================================

echo "Original population SNPs:"
bcftools view -H "$POP" | wc -l

# 532192

echo "Callable in both outgroups:"
bcftools view -H Bats.callable_in_both_outgroups.vcf.gz | wc -l

# 322276

echo "Polarized SNPs:"
bcftools view -H Bats.ancestral.vcf.gz | wc -l

# 300528

echo "AA=REF:"
bcftools query -f '%REF\t%INFO/AA\n' Bats.ancestral.vcf.gz \
    | awk '$1==$2' \
    | wc -l

# 297076

echo "AA=ALT:"
bcftools query -f '%ALT\t%INFO/AA\n' Bats.ancestral.vcf.gz \
