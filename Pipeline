#!/bin/bash

REF="/Mystacinus.fna"
OUTDIR="/FASTAS"

mkdir -p "$OUTDIR"

for bam in *.bam; do

    sample="${bam%.bam}"

    echo "Processing ${sample}..."

    # Index BAM if needed
    [[ -f "${bam}.bai" ]] || samtools index "$bam"

    # ------------------------------------------------------------
    # 1. Call variants
    # ------------------------------------------------------------

    bcftools mpileup \
        -Ou \
        -f "$REF" \
        -a FORMAT/DP,FORMAT/AD \
        -q 20 \
        -Q 20 \
        "$bam" |
    bcftools call \
        -m \
        -Ou |
    bcftools norm \
        -f "$REF" \
        -Oz \
        -o "${OUTDIR}/${sample}.vcf.gz"

    bcftools index -f "${OUTDIR}/${sample}.vcf.gz"

    # ------------------------------------------------------------
    # 2. Keep SNPs only
    #
    # Important:
    # Indels must NOT be incorporated into the consensus because
    # they change chromosome lengths and therefore shift the
    # Mystacinus reference coordinates used by the GFF/BED files.
    # ------------------------------------------------------------

    bcftools view \
        -v snps \
        -Oz \
        -o "${OUTDIR}/${sample}.snps.vcf.gz" \
        "${OUTDIR}/${sample}.vcf.gz"

    bcftools index -f "${OUTDIR}/${sample}.snps.vcf.gz"


    # ------------------------------------------------------------
    # 3. Mask positions with low read depth
    # ------------------------------------------------------------

    samtools depth \
        -aa \
        -q 20 \
        -Q 20 \
        "$bam" |
    awk '$3 < 3 {print $1"\t"$2-1"\t"$2}' \
        > "${OUTDIR}/${sample}_lowcoverage.bed"


    # ------------------------------------------------------------
    # 4. Add SNP positions with unreliable genotype calls
    # ------------------------------------------------------------

    bcftools query \
        -i 'FMT/DP<3 || FMT/GQ<20' \
        -f '%CHROM\t%POS0\t%POS\n' \
        "${OUTDIR}/${sample}.snps.vcf.gz" \
        >> "${OUTDIR}/${sample}_lowcoverage.bed"


    # ------------------------------------------------------------
    # 5. Sort and merge masked regions
    # ------------------------------------------------------------

    sort -k1,1 -k2,2n \
        "${OUTDIR}/${sample}_lowcoverage.bed" |
    bedtools merge \
        > "${OUTDIR}/${sample}_mask.bed"


    # ------------------------------------------------------------
    # 6. Generate reference-coordinate consensus
    #
    # Only SNPs are inserted. Indels are excluded so every
    # consensus sequence remains in Mystacinus coordinates.
    # ------------------------------------------------------------

    bcftools consensus \
        -f "$REF" \
        -H I \
        -m "${OUTDIR}/${sample}_mask.bed" \
        "${OUTDIR}/${sample}.snps.vcf.gz" \
        > "${OUTDIR}/${sample}.fna"


    # Index consensus FASTA
    samtools faidx "${OUTDIR}/${sample}.fna"

done

echo "All consensus sequences generated."

