########################################
# STEP 1. Extract CDS annotations once
########################################

GFF="Mystacinus.gff"
GENE_LIST="genes.txt"

mkdir -p candidate_gene_gff_longest

while read -r gene; do

    [[ -z "$gene" || "$gene" == \#* ]] && continue

    echo "Processing $gene"

    # Extract all CDS lines for this gene
    awk -F'\t' -v gene="$gene" '
        BEGIN {IGNORECASE=1}
        $3=="CDS" &&
        $9 ~ ("gene=" gene ";|gene=" gene "$|gene_name=" gene ";|gene_name=" gene "$")
    ' "$GFF" > tmp_gene.gff

    if [[ ! -s tmp_gene.gff ]]; then
        echo "  No CDS found"
        continue
    fi

    # Calculate total CDS length for each transcript
    awk -F'\t' '
        {
            if (match($9,/Parent=([^;]+)/,a)) {
                parent=a[1]
                cdslen[parent] += ($5-$4+1)
            }
        }
        END {
            for (p in cdslen)
                print p, cdslen[p]
        }
    ' tmp_gene.gff \
    | sort -k2,2nr \
    > tmp_transcripts.txt

    # Select transcript with longest CDS
    transcript=$(head -1 tmp_transcripts.txt | awk '{print $1}')

    echo "  Selected: $transcript"

    # Keep only CDS lines belonging to selected transcript
    awk -F'\t' -v transcript="$transcript" '
        $9 ~ ("Parent=" transcript ";") ||
        $9 ~ ("Parent=" transcript "$")
    ' tmp_gene.gff \
    > "candidate_gene_gff_longest/${gene}.gff"

done < "$GENE_LIST"

rm -f tmp_gene.gff tmp_transcripts.txt


########################################
# STEP 2. Convert CDS coordinates to BED once
########################################

for gff in candidate_gene_gff_longest/*.gff; do
    gene=$(basename "$gff" .gff)

    awk -F'\t' -v gene="$gene" '
        BEGIN {OFS="\t"}
        $0 !~ /^#/ && $3=="CDS" {
            print $1, $4-1, $5, gene, ".", $7
        }
    ' "$gff" > "candidate_gene_gff_longest/${gene}.bed"
done


