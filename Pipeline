  left_join(chr_key, by = "Chr") %>%
  arrange(Chr_num) %>%
  mutate(
    offset = lag(cumsum(Length), default = 0),
    midpoint = offset + Length / 2
  )

# Add cumulative genomic coordinates
roh_plot <- roh %>%
  left_join(
    chr_lengths %>% select(Chr, offset),
    by = "Chr"
  ) %>%
  mutate(
    genome_start = Start + offset,
    genome_end = End + offset,
    Morph = ifelse(grepl("^D", Sample), "Dark", "Pale"),
    Sample = factor(
      Sample,
      levels = c("D1", "D2", "D3", "P1", "P2", "P3", "P4")
    )
  )

# Then plot:

ggplot(roh_plot) +
  geom_segment(
    aes(
      x = genome_start,
      xend = genome_end,
      y = Sample,
      yend = Sample,
      colour = Morph
    ),
    linewidth = 4,
    lineend = "round"
  ) +
  scale_x_continuous(
    breaks = chr_lengths$midpoint,
    labels = chr_lengths$Chr_num,
    expand = c(0.01, 0.01)
  ) +
  scale_y_discrete(limits = rev) +
  labs(
    x = "Chromosome",
    y = NULL,
    colour = "Colour morph"
  ) +
  theme_classic(base_size = 12) +
  theme(
    axis.text.x = element_text(size = 9),
    axis.ticks.x = element_blank(),
    legend.position = "top"
  )

# 3. Add chromosome boundaries

ggplot(roh_plot) +
  geom_vline(
    xintercept = chr_lengths$offset[-1],
    linewidth = 0.25,
    colour = "grey85"
  ) +
  geom_segment(
    aes(
